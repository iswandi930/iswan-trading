//@version=5
indicator("X-Core Universal — M15 / 5M / 1M V5", overlay=true, max_lines_count=200, max_labels_count=100)

// X-Core Universal: all liquid markets.
// Core direction: H4 -> H1 -> M30 -> M15. Timing: 5M -> 1M.
// BUY = green arrow below price. SELL = red arrow above price.
// Signals use confirmed data. Small counter-candles do not flip the active direction.

emaFastLen = input.int(20, "EMA Fast", minval=2)
emaTrendLen = input.int(50, "EMA Trend", minval=5)
emaSlowLen = input.int(200, "EMA Slow", minval=20)
rsiLen = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(18.0, "Minimum ADX", minval=1.0, step=0.5)
atrLen = input.int(14, "ATR Length", minval=2)
pivotLen = input.int(3, "Swing Confirmation", minval=2, maxval=10)
volumeLen = input.int(20, "Volume Average", minval=5)
volumeMult = input.float(0.9, "Minimum Volume Ratio", minval=0.1, step=0.05)
rr = input.float(1.8, "Target Risk/Reward", minval=0.5, step=0.1)
slAtr = input.float(0.25, "SL ATR Buffer", minval=0.0, step=0.05)
arrowBarsMin = input.int(5, "Minimum Arrow Projection", minval=2, maxval=20)
arrowBarsMax = input.int(14, "Maximum Arrow Projection", minval=4, maxval=30)
useDxyFilter = input.bool(true, "DXY Confirmation")
dxySymbol = input.symbol("TVC:DXY", "DXY Symbol")
useYieldFilter = input.bool(true, "US 10Y Yield Confirmation")
yieldSymbol = input.symbol("TVC:US10Y", "US 10Y Yield Symbol")
useLowerTiming = input.bool(true, "5M + 1M Timing Confirmation")

f_htfBull(tf) =>
    request.security(syminfo.tickerid, tf, close[1] > ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] > ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] > ta.ema(close, emaSlowLen)[1] and ta.rising(ta.ema(close, emaTrendLen), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

f_htfBear(tf) =>
    request.security(syminfo.tickerid, tf, close[1] < ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] < ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] < ta.ema(close, emaSlowLen)[1] and ta.falling(ta.ema(close, emaTrendLen), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

f_htfStructureBull(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivothigh(high, pivotLen, pivotLen) > ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) > ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

f_htfStructureBear(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivothigh(high, pivotLen, pivotLen) < ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) < ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

h4Bull = f_htfBull("240")
h1Bull = f_htfBull("60")
m30Bull = f_htfBull("30")
h4Bear = f_htfBear("240")
h1Bear = f_htfBear("60")
m30Bear = f_htfBear("30")
h4StructBull = f_htfStructureBull("240")
h1StructBull = f_htfStructureBull("60")
m30StructBull = f_htfStructureBull("30")
h4StructBear = f_htfStructureBear("240")
h1StructBear = f_htfStructureBear("60")
m30StructBear = f_htfStructureBear("30")

// M15 is explicitly used as the decision timeframe, regardless of chart timeframe.
f_m15Bull() =>
    request.security(syminfo.tickerid, "15", close[1] > ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] > ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] > ta.ema(close, emaSlowLen)[1] and ta.rising(ta.ema(close, emaTrendLen), 2)[1] and ta.rsi(close, rsiLen)[1] > 52 and ta.dmi(adxLen, adxLen)[0][1] > ta.dmi(adxLen, adxLen)[1][1] and ta.dmi(adxLen, adxLen)[2][1] >= adxMin, barmerge.gaps_off, barmerge.lookahead_off)

f_m15Bear() =>
    request.security(syminfo.tickerid, "15", close[1] < ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] < ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] < ta.ema(close, emaSlowLen)[1] and ta.falling(ta.ema(close, emaTrendLen), 2)[1] and ta.rsi(close, rsiLen)[1] < 48 and ta.dmi(adxLen, adxLen)[1][1] > ta.dmi(adxLen, adxLen)[0][1] and ta.dmi(adxLen, adxLen)[2][1] >= adxMin, barmerge.gaps_off, barmerge.lookahead_off)

m15BullBase = f_m15Bull()
m15BearBase = f_m15Bear()

// Confirmed M15 structure, calculated directly in the M15 context.
f_m15StructureBull() =>
    request.security(syminfo.tickerid, "15", ta.pivothigh(high, pivotLen, pivotLen) > ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) > ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

f_m15StructureBear() =>
    request.security(syminfo.tickerid, "15", ta.pivothigh(high, pivotLen, pivotLen) < ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) < ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

m15StructBull = f_m15StructureBull()
m15StructBear = f_m15StructureBear()

// Current chart metrics are used for risk/arrow placement only.
ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaTrendLen)
ema200 = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

range = math.max(high - low, syminfo.mintick)
bullBody = close > open and close >= high - range * 0.35
bearBody = close < open and close <= low + range * 0.35
volAvg = ta.sma(volume, volumeLen)
volumeOK = na(volume) or na(volAvg) or volume >= volAvg * volumeMult

// M15 trigger: use the last confirmed M15 candle for confirmation, with current-chart pullback/volatility used only as execution filters.
m15BullTrigger = m15BullBase and m15StructBull
m15BearTrigger = m15BearBase and m15StructBear

pullbackBull = ta.lowest(low, 5) <= ema20 or ta.lowest(low, 5) <= ema50
pullbackBear = ta.highest(high, 5) >= ema20 or ta.highest(high, 5) >= ema50
executionBull = pullbackBull and bullBody and volumeOK
aexecutionBear = pullbackBear and bearBody and volumeOK

// Gold-only macro layer. Missing macro data does not block the signal.
dxyClose = request.security(dxySymbol, "15", close[1], barmerge.gaps_off, barmerge.lookahead_off)
dxyEma20 = request.security(dxySymbol, "15", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
dxyBull = not na(dxyClose) and dxyClose > dxyEma20
dxyBear = not na(dxyClose) and dxyClose < dxyEma20
yieldClose = request.security(yieldSymbol, "15", close[1], barmerge.gaps_off, barmerge.lookahead_off)
yieldEma20 = request.security(yieldSymbol, "15", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
yieldRising = not na(yieldClose) and yieldClose > yieldEma20
yieldFalling = not na(yieldClose) and yieldClose < yieldEma20

a = str.upper(syminfo.ticker)
b = str.upper(syminfo.description)
isGold = str.contains(a, "XAU") or str.contains(b, "GOLD")
dxyOK = na(dxyClose) or dxyBear or not useDxyFilter
yieldBuyOK = na(yieldClose) or yieldFalling or not useYieldFilter
dxySellOK = na(dxyClose) or dxyBull or not useDxyFilter
yieldSellOK = na(yieldClose) or yieldRising or not useYieldFilter
macroBuyOK = not isGold or (dxyOK and yieldBuyOK)
macroSellOK = not isGold or (dxySellOK and yieldSellOK)

atrBase = ta.sma(atr, 50)
volatilityOK = na(atrBase) or atr <= atrBase * 2.2

htfBullStructureOK = na(h4StructBull) or h4StructBull
htfBullStructureOK := htfBullStructureOK and (na(h1StructBull) or h1StructBull) and (na(m30StructBull) or m30StructBull)
htfBearStructureOK = na(h4StructBear) or h4StructBear
htfBearStructureOK := htfBearStructureOK and (na(h1StructBear) or h1StructBear) and (na(m30StructBear) or m30StructBear)

// 5M -> 1M timing. These are only enforced on M5/M1 charts, so higher charts keep the M15 core signal.
f_tfTrendBull(tf) =>
    request.security(syminfo.tickerid, tf, close[1] > ta.ema(close, 20)[1] and ta.ema(close, 20)[1] > ta.ema(close, 50)[1] and ta.rising(ta.ema(close, 20), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

f_tfTrendBear(tf) =>
    request.security(syminfo.tickerid, tf, close[1] < ta.ema(close, 20)[1] and ta.ema(close, 20)[1] < ta.ema(close, 50)[1] and ta.falling(ta.ema(close, 20), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

m5Bull = f_tfTrendBull("5")
m5Bear = f_tfTrendBear("5")
m1Bull = f_tfTrendBull("1")
m1Bear = f_tfTrendBear("1")
lowerBull = m5Bull and m1Bull
lowerBear = m5Bear and m1Bear
chartSeconds = timeframe.in_seconds()
useLowerGate = useLowerTiming and not na(chartSeconds) and chartSeconds <= 300

rawBuy = barstate.isconfirmed and h4Bull and h1Bull and m30Bull and htfBullStructureOK and m15BullTrigger and executionBull and macroBuyOK and volatilityOK and (not useLowerGate or lowerBull)
rawSell = barstate.isconfirmed and h4Bear and h1Bear and m30Bear and htfBearStructureOK and m15BearTrigger and executionBull == false and executionBear and macroSellOK and volatilityOK and (not useLowerGate or lowerBear)

// Persistent direction: a counter candle alone never changes the active direction.
var int directionState = 0
buySignal = rawBuy and directionState != 1 and not rawSell
sellSignal = rawSell and directionState != -1 and not rawBuy
if buySignal
    directionState := 1
else if sellSignal
    directionState := -1

buySL = na(lastSwingLow) ? close - atr : lastSwingLow - atr * slAtr
sellSL = na(lastSwingHigh) ? close + atr : lastSwingHigh + atr * slAtr
buyRisk = math.max(close - buySL, syminfo.mintick)
sellRisk = math.max(sellSL - close, syminfo.mintick)
buyTarget = math.max(close + buyRisk * rr, nz(lastSwingHigh, close + atr * rr))
sellTarget = math.min(close - sellRisk * rr, nz(lastSwingLow, close - atr * rr))

rsiBullScore = math.max(0.0, math.min(1.0, (rsi - 50.0) / 20.0))
rsiBearScore = math.max(0.0, math.min(1.0, (50.0 - rsi) / 20.0))
adxScore = math.max(0.0, math.min(1.0, (adx - adxMin) / 20.0))
bodyBullScore = math.max(0.0, math.min(1.0, (close - open) / range))
bodyBearScore = math.max(0.0, math.min(1.0, (open - close) / range))
buyStrength = math.max(0.0, math.min(1.0, rsiBullScore * 0.35 + adxScore * 0.35 + bodyBullScore * 0.30))
sellStrength = math.max(0.0, math.min(1.0, rsiBearScore * 0.35 + adxScore * 0.35 + bodyBearScore * 0.30))
buyArrowBars = int(math.round(arrowBarsMin + (arrowBarsMax - arrowBarsMin) * buyStrength))
sellArrowBars = int(math.round(arrowBarsMin + (arrowBarsMax - arrowBarsMin) * sellStrength))

var line activeBuy = na
var line activeSell = na
if buySignal
    if not na(activeBuy)
        line.delete(activeBuy)
    activeBuy := line.new(bar_index, low - atr * 0.30, bar_index + buyArrowBars, buyTarget, xloc=xloc.bar_index, extend=extend.none, color=color.green, width=4, style=line.style_arrow_right)
if sellSignal
    if not na(activeSell)
        line.delete(activeSell)
    activeSell := line.new(bar_index, high + atr * 0.30, bar_index + sellArrowBars, sellTarget, xloc=xloc.bar_index, extend=extend.none, color=color.red, width=4, style=line.style_arrow_right)

plotchar(buySignal, "BUY", "↑", location=location.belowbar, color=color.green, display=display.data_window)
plotchar(sellSignal, "SELL", "↓", location=location.abovebar, color=color.red, display=display.data_window)
alertcondition(buySignal, "X-Core BUY", "X-Core BUY on {{ticker}} {{interval}}")
alertcondition(sellSignal, "X-Core SELL", "X-Core SELL on {{ticker}} {{interval}}")
plot(ema20, "EMA 20", color=color.new(color.aqua, 0), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.orange, 0), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
