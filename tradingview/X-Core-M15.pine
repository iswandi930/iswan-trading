//@version=5
indicator("X-Core M15 — BUY / SELL / WAIT V3", overlay=true, max_lines_count=200, max_labels_count=100)

// X-Core V3
// Main chart: M15. Direction chain: H4 -> H1 -> M30 -> M15.
// Visual rule: green BUY arrow below price, red SELL arrow above price.
// No BUY/SELL text labels. Signals use closed candles and confirmed HTF bars.
// Macro confirmation: DXY + US 10Y yield. News-risk protection: abnormal ATR expansion.

emaFastLen = input.int(20, "EMA Fast", minval=2)
emaTrendLen = input.int(50, "EMA Trend", minval=5)
emaSlowLen = input.int(200, "EMA Slow", minval=20)
rsiLen = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(18.0, "Minimum ADX", minval=1.0, step=0.5)
atrLen = input.int(14, "ATR Length", minval=2)
pivotLen = input.int(3, "Swing Confirmation", minval=2, maxval=10)
volumeLen = input.int(20, "Volume Average", minval=5)
volumeMult = input.float(0.9, "Minimum Volume Ratio", minval=0.1, step=0.05)
rr = input.float(1.8, "Target Risk/Reward", minval=0.5, step=0.1)
slAtr = input.float(0.25, "SL ATR Buffer", minval=0.0, step=0.05)
arrowBarsMin = input.int(5, "Minimum Arrow Projection", minval=2, maxval=20)
arrowBarsMax = input.int(14, "Maximum Arrow Projection", minval=4, maxval=30)
useDxyFilter = input.bool(true, "DXY Confirmation")
dxySymbol = input.symbol("TVC:DXY", "DXY Symbol")
useYieldFilter = input.bool(true, "US 10Y Yield Confirmation")
yieldSymbol = input.symbol("TVC:US10Y", "US 10Y Yield Symbol")

f_htfBull(tf) =>
    request.security(syminfo.tickerid, tf, close[1] > ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] > ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] > ta.ema(close, emaSlowLen)[1] and ta.rising(ta.ema(close, emaTrendLen), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

f_htfBear(tf) =>
    request.security(syminfo.tickerid, tf, close[1] < ta.ema(close, emaFastLen)[1] and ta.ema(close, emaFastLen)[1] < ta.ema(close, emaTrendLen)[1] and ta.ema(close, emaTrendLen)[1] < ta.ema(close, emaSlowLen)[1] and ta.falling(ta.ema(close, emaTrendLen), 2)[1], barmerge.gaps_off, barmerge.lookahead_off)

// Confirmed swing structure on each higher timeframe.
f_htfStructureBull(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivothigh(high, pivotLen, pivotLen) > ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) > ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

f_htfStructureBear(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivothigh(high, pivotLen, pivotLen) < ta.pivothigh(high, pivotLen, pivotLen)[pivotLen * 2] and ta.pivotlow(low, pivotLen, pivotLen) < ta.pivotlow(low, pivotLen, pivotLen)[pivotLen * 2], barmerge.gaps_off, barmerge.lookahead_off)

h4Bull = f_htfBull("240")
h1Bull = f_htfBull("60")
m30Bull = f_htfBull("30")
h4Bear = f_htfBear("240")
h1Bear = f_htfBear("60")
m30Bear = f_htfBear("30")
h4StructBull = f_htfStructureBull("240")
h1StructBull = f_htfStructureBull("60")
m30StructBull = f_htfStructureBull("30")
h4StructBear = f_htfStructureBear("240")
h1StructBear = f_htfStructureBear("60")
m30StructBear = f_htfStructureBear("30")

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaTrendLen)
ema200 = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)

// Confirmed M15 market structure.
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
var float prevSwingHigh = na
var float prevSwingLow = na
if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

bullStructure = not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingHigh > prevSwingHigh and lastSwingLow > prevSwingLow
bearStructure = not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingHigh < prevSwingHigh and lastSwingLow < prevSwingLow

range = math.max(high - low, syminfo.mintick)
bullBody = close > open and close >= high - range * 0.35
bearBody = close < open and close <= low + range * 0.35
breakBull = not na(lastSwingHigh) and close > lastSwingHigh
breakBear = not na(lastSwingLow) and close < lastSwingLow
pullbackBull = ta.lowest(low, 5) <= ema20 or ta.lowest(low, 5) <= ema50
pullbackBear = ta.highest(high, 5) >= ema20 or ta.highest(high, 5) >= ema50

volAvg = ta.sma(volume, volumeLen)
volumeOK = na(volume) or na(volAvg) or volume >= volAvg * volumeMult

// Momentum quality: stronger momentum gives more confidence and a longer projected arrow.
rsiBullScore = math.max(0.0, math.min(1.0, (rsi - 50.0) / 20.0))
rsiBearScore = math.max(0.0, math.min(1.0, (50.0 - rsi) / 20.0))
adxScore = math.max(0.0, math.min(1.0, (adx - adxMin) / 20.0))
bodyBullScore = math.max(0.0, math.min(1.0, (close - open) / range))
bodyBearScore = math.max(0.0, math.min(1.0, (open - close) / range))

m15Bull = close > ema20 and ema20 > ema50 and ema50 > ema200 and ta.rising(ema50, 2) and rsi > 52 and adx >= adxMin and diPlus > diMinus and pullbackBull and bullBody and (breakBull or bullStructure) and volumeOK
m15Bear = close < ema20 and ema20 < ema50 and ema50 < ema200 and ta.falling(ema50, 2) and rsi < 48 and adx >= adxMin and diMinus > diPlus and pullbackBear and bearBody and (breakBear or bearStructure) and volumeOK

// DXY is a macro confirmation for gold. Rising DXY blocks BUY; falling DXY blocks SELL.
dxyClose = request.security(dxySymbol, "15", close[1], barmerge.gaps_off, barmerge.lookahead_off)
dxyEma20 = request.security(dxySymbol, "15", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
dxyBull = dxyClose > dxyEma20
dxyBear = dxyClose < dxyEma20

// US 10Y yield confirmation for gold. Rising yield is a headwind; falling yield supports gold.
yieldClose = request.security(yieldSymbol, "15", close[1], barmerge.gaps_off, barmerge.lookahead_off)
yieldEma20 = request.security(yieldSymbol, "15", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
yieldRising = yieldClose > yieldEma20
yieldFalling = yieldClose < yieldEma20

isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.description), "GOLD")
macroBuyOK = not isGold or ((not useDxyFilter or dxyBear) and (not useYieldFilter or yieldFalling))
macroSellOK = not isGold or ((not useDxyFilter or dxyBull) and (not useYieldFilter or yieldRising))

// Volatility/news-risk proxy: avoid entries during abnormal M15 ATR expansion.
atrBase = ta.sma(atr, 50)
volatilityOK = na(atrBase) or atr <= atrBase * 2.2

// Higher-timeframe structure is a second confirmation layer. If structure is unavailable early in history,
// the EMA trend layer remains the primary direction filter.
htfBullStructureOK = (na(h4StructBull) or h4StructBull) and (na(h1StructBull) or h1StructBull) and (na(m30StructBull) or m30StructBull)
htfBearStructureOK = (na(h4StructBear) or h4StructBear) and (na(h1StructBear) or h1StructBear) and (na(m30StructBear) or m30StructBear)

rawBuy = barstate.isconfirmed and h4Bull and h1Bull and m30Bull and htfBullStructureOK and m15Bull and macroBuyOK and volatilityOK
rawSell = barstate.isconfirmed and h4Bear and h1Bear and m30Bear and htfBearStructureOK and m15Bear and macroSellOK and volatilityOK
buySignal = rawBuy and not rawSell
sellSignal = rawSell and not rawBuy

// Structure-aware targets. Entry is close; stop sits beyond the latest confirmed swing.
buySL = na(lastSwingLow) ? close - atr : lastSwingLow - atr * slAtr
sellSL = na(lastSwingHigh) ? close + atr : lastSwingHigh + atr * slAtr
buyRisk = math.max(close - buySL, syminfo.mintick)
sellRisk = math.max(sellSL - close, syminfo.mintick)
buyTarget = math.max(close + buyRisk * rr, nz(lastSwingHigh, close + atr * rr))
sellTarget = math.min(close - sellRisk * rr, nz(lastSwingLow, close - atr * rr))

// Dynamic arrow projection: stronger momentum/ADX gets a longer projection, weak setups get a shorter one.
buyStrength = math.max(0.0, math.min(1.0, rsiBullScore * 0.35 + adxScore * 0.35 + bodyBullScore * 0.30))
sellStrength = math.max(0.0, math.min(1.0, rsiBearScore * 0.35 + adxScore * 0.35 + bodyBearScore * 0.30))
buyArrowBars = math.round(arrowBarsMin + (arrowBarsMax - arrowBarsMin) * buyStrength)
sellArrowBars = math.round(arrowBarsMin + (arrowBarsMax - arrowBarsMin) * sellStrength)

// Required visual: green BUY arrow below price and red SELL arrow above price.
var line activeBuy = na
var line activeSell = na
if buySignal
    if not na(activeBuy)
        line.delete(activeBuy)
    activeBuy := line.new(bar_index, low - atr * 0.30, bar_index + buyArrowBars, buyTarget, xloc=xloc.bar_index, extend=extend.none, color=color.green, width=4, style=line.style_arrow_right)
if sellSignal
    if not na(activeSell)
        line.delete(activeSell)
    activeSell := line.new(bar_index, high + atr * 0.30, bar_index + sellArrowBars, sellTarget, xloc=xloc.bar_index, extend=extend.none, color=color.red, width=4, style=line.style_arrow_right)

plotchar(buySignal, "BUY", "↑", location=location.belowbar, color=color.green, display=display.data_window)
plotchar(sellSignal, "SELL", "↓", location=location.abovebar, color=color.red, display=display.data_window)

alertcondition(buySignal, "X-Core BUY", "X-Core BUY on {{ticker}} {{interval}}")
alertcondition(sellSignal, "X-Core SELL", "X-Core SELL on {{ticker}} {{interval}}")

plot(ema20, "EMA 20", color=color.new(color.aqua, 0), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.orange, 0), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
