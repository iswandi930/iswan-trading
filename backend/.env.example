# Keep the real API key only in the hosting provider's secret/environment settings.
MASSIVE_API_KEY=your_massive_api_key
# Optional futures ticker overrides if the provider/account uses different symbols.
MASSIVE_USOIL_TICKER=CL
MASSIVE_UKOIL_TICKER=BZ
MASSIVE_NATGAS_TICKER=NG
MASSIVE_COPPER_TICKER=HG
